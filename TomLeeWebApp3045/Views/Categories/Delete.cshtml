@using TomLeeWebApp3045.Models
@model TomLeeWebApp3045.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}
<h6><a href="/Home">Home </a> 
    / 
    <a href="/Categories"> Categories </a>
    / @ViewData["Title"]
</h6>

@if (Model != null)
{
    <h3>Delete Category: @Model.Name</h3>
}
else
{
    <h3>Delete Category: Unregistered</h3>
}

<br />
<p>Are you sure you want to delete this category?<br /></p>
<form method="post" asp-action="Delete" asp-controller="Categories">
    <input type="hidden" name="CategoryId" value="@Model.CategoryId" />
    <div class = "text-danger" asp-validation-summary="All"></div>
    
    <div class = "row md-3">
        <div class = "col-2">
            <label asp-for="Name" class = "col-form-label"><h4>Name:</h4></label>
        </div>
        <div class = "col-md-6">
            <label asp-for="Name" class="col-form-label">
                <h4>@Model.Name</h4>
            </label>
        </div>
        <div class = "col">
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>


    <div class = "row md-3">
        <div class="col-2">
            <label asp-for="Description" class="col-form-label"><h4>Description:</h4></label>
        </div>
        <div class="col-md-6">
            <label asp-for="Description" class="col-form-label">
                <h4>@Model.Description</h4>
            </label>
        </div>
        <div class = "col">
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>
<br/>
<br/>
<button type="submit" class="btn btn-primary">Delete Category</button>
</form>