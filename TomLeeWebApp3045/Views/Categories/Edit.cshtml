@using TomLeeWebApp3045.Models
@model TomLeeWebApp3045.Models.Category
@{
    ViewData["Title"] = "Edit Category";
}
<h6><a href="/Home">Home </a>
    /
    <a href="/Categories"> Categories </a>
    / @ViewData["Title"]
</h6>

@if (Model != null)
{
    <h3>Edit Category: @Model.Name</h3>
}
else
{
    <h3>Edit Category: Unregistered</h3>
}



<br/>
<p>Welcome to the Edit Category page!<br/></p>
<p>Here you can change how you categorize your texts.<br/></p>
<form method="post" asp-action="Edit" asp-controller="Categories">
    <input type="hidden" name="CategoryId" value="@Model.CategoryId" />
    <div class = "text-danger" asp-validation-summary="All"></div>
    
    <div class = "row md-3">
        <div class = "col-2">
            <label asp-for="Name" class = "col-form-label"><h4>Name:</h4></label>
        </div>
        <div class = "col-lg-6">
            <input type="text" class="form-control" id="name" name="name" value="@Model.Name" required>
        </div>
        <div class = "col">
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>


    <div class = "row md-3">
        <div class="col-2">
            <label asp-for="Description" class="col-form-label"><h4>Description:</h4></label>
        </div>
        <div class="col-lg-6">
            <input type="text" class="form-control" id="description" name="description" value="@Model.Description" required>    
        </div>
        <div class = "col">
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>
<br/>
<br/>
<button type="submit" class="btn btn-primary">Save Changes</button>
    
</form>
